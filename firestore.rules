rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ----------------------------------------------------------------------
    // TEMPORARY DEV MODE (OPEN ACCESS)
    // ----------------------------------------------------------------------
    // NOTE: Firestore uses the *most specific* matching rule. To truly open
    // everything, keep only this catch-all match.
    //
    // Remember to lock this down before production.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
